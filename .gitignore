# ---- Go build output ----
# `go build ./internal/main` names the binary after the package directory.
/main
/main.exe
/client-directory
/client-directory.exe
/bin/
/dist/
*.exe
*.exe~
*.dll
*.so
*.dylib
*.test

# ---- Go tooling ----
*.out
coverage.*
*.coverprofile
*.prof
*.pprof
__debug_bin*
go.work
go.work.sum
/vendor/

# ---- Configuration and secrets ----
# config.json holds real secrets and stays local. config.example.json is the
# committed template (copied into the Docker image and used by CI):
#   cp config.example.json config.json   # then fill in the secrets
.env
.env.*
!.env.example
config.local.json
config.json
config.*.local.json
*.pem
*.key

# ---- Local data and logs ----
*.log
/tmp/
*.sql.gz
*.dump

# ---- Editors ----
.vscode/*
!.vscode/settings.json
!.vscode/extensions.json
!.vscode/launch.json
.idea/
*.swp
*.swo
*~

# ---- OS ----
.DS_Store
Thumbs.db
ehthumbs.db
Desktop.ini
$RECYCLE.BIN/
